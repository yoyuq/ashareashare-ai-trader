# ====== A股智能分析Agent — 环境变量模板 (v3.1) ======
# 复制此文件为 .env 并填入真实值

# ---- DeepSeek API (必需) ----
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---- API 认证 ----
# 保护本服务 REST API 的密码 (你自己定义的任意字符串, 与 DeepSeek 等 AI 模型 key 无关)
# 调用时经 X-API-Key 请求头传递: curl -H "X-API-Key: your-api-key-here" ...
# 安全默认 (fail-closed): 未设置 API_KEY 时, 除健康检查外所有请求返回 403
API_KEY=your-api-key-here
# 本地开发便利开关: 设为 true 时, 未配置 API_KEY 也允许无认证访问 (生产环境切勿开启)
API_ALLOW_INSECURE_NO_AUTH=false
# CORS 来源白名单 (逗号分隔), 不设置默认 * ; 生产环境务必收敛为实际前端域名
# CORS_ORIGINS=http://localhost:3000,https://your-domain.com

# ---- 数据库 (可选) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ashare_trader
POSTGRES_USER=ashare
POSTGRES_PASSWORD=change_me_strong_password

# ---- Redis (可选) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- 模型 (v3.0 全量统一 DeepSeek V4-Flash) ----
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash

# ---- 免费模型池 (可选, 用于全市场预筛) ----
ZHIPU_API_KEY=your-zhipu-api-key
ZHIPU_API_KEY_2=your-zhipu-api-key-2
BAIDU_QIANFAN_API_KEY=your-baidu-qianfan-key
SILICONFLOW_API_KEY=your-siliconflow-key

# ---- Tushare Pro (付费数据,可选) ----
TUSHARE_TOKEN=your-tushare-token

# ---- 数据源优先级 (可选) ----
# 格式: "tushare,baostock,tencent,eastmoney,akshare"
DATA_PROVIDER_ORDER=

# ---- 消息推送 (可选) ----
WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# ---- QMT 实盘交易 (可选, 高风险) ----
QMT_ACCOUNT_ID=
QMT_PATH=
QMT_SESSION_ID=
BROKER_TYPE=

# ---- 模型行为 ----
SKIP_PEAK_HOUR=0
DAILY_COST_ALERT_THRESHOLD=1.0

# ---- 日志 ----
LOG_LEVEL=INFO
LOG_PATH=./logs

# ---- 网络代理 (可选) ----
# HTTP_PROXY=
# HTTPS_PROXY=
